# CONFIGURATION REFERENCE ONLY — no real secrets belong in this file.
# Use your runtime's environment/Secrets. The app does not automatically load .env.
#
# Database connection is supplied by the database configuration:
DATABASE_URL=
#
# Private session-signing value:
SESSION_SECRET=
#
# Configure Replit AI Integrations; these are required at API startup:
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
#
# For private receipt storage, configure App Storage in the target Replit app:
PRIVATE_OBJECT_DIR=
#
# Replit supplies REPL_ID. ISSUER_URL has a default in the receipt auth source.
# Do not copy another app's runtime identity or storage credentials.
#
# PORT and frontend BASE_PATH are per-artifact settings in artifact.toml.
# Do not set a single global PORT for every workflow.
