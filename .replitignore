# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
__pycache__/
.pytest_cache/
/.cache/
/.config/chromium-headless/

# Keep local reference documents and the downloadable film export out of the website image.
/attached_assets/
/*.mp4
/*.webm
/*.mov
